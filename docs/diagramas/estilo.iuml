' Colores de las capas del diagrama de arquitectura.
skinparam dpi 200
hide stereotype
skinparam shadowing false
skinparam defaultFontName Roboto
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 420

<style>
root {
  FontName Roboto
  FontColor #1F2D3D
  LineColor #52606D
  BackGroundColor #FFFFFF
}
title {
  FontSize 20
  FontStyle bold
  Margin 10 0 18 0
  LineColor transparent
  BackGroundColor transparent
}
sequenceDiagram {
  FontSize 13
  participant, actor, database {
    FontSize 14
    FontStyle bold
    RoundCorner 12
    LineThickness 1.5
    Padding 10
  }
  actor {
    BackGroundColor #F5F7FA
    LineColor #52606D
  }
  stereotype {
    FontSize 11
    FontStyle italic
    FontColor #52606D
  }
  lifeLine {
    LineColor #B8C2CC
    LineStyle 5-4
  }
  arrow {
    LineColor #334E68
    LineThickness 1.2
  }
  group {
    LineColor #829AB1
    LineThickness 1.2
    BackGroundColor #FFFFFF
  }
  groupHeader {
    FontStyle bold
    FontColor #243B53
    BackGroundColor #D9E2EC
    LineColor #829AB1
  }
  separator {
    LineColor #829AB1
  }
  note {
    BackGroundColor #FFFDF3
    LineColor #D6B656
    FontSize 12
    FontStyle italic
  }
  .presentación {
    BackGroundColor #FFF2CC
    LineColor #D6B656
  }
  .dominio {
    BackGroundColor #E1D5E7
    LineColor #9673A6
  }
  .persistencia {
    BackGroundColor #D5E8D4
    LineColor #82B366
  }
}
</style>
