@startuml enviar-solicitud
!include ../estilo.iuml
hide footbox
autonumber
title Enviar una solicitud de reserva (US-02)

actor "Docente / Solicitante" as S
participant "<b>solicitudes.views</b>\n<size:11>solicitudes/views.py</size>" as N <<presentación>>
participant "<b>solicitudes.wizard</b>\n<size:11>solicitudes/wizard.py</size>" as W <<presentación>>
participant "<b>solicitudes</b>\n<size:11>solicitudes/services.py</size>\n<size:11>solicitudes/models.py</size>" as V <<dominio>>
participant "<b>configuracion</b>\n<size:11>configuracion/models.py</size>" as C <<dominio>>
participant "<b>agenda</b>\n<size:11>agenda/models.py</size>" as A <<dominio>>
database "<b>PostgreSQL</b>\n<size:11>base oev</size>" as D <<persistencia>>

S -> N ++ : POST /solicitar/ (paso=confirmacion) → solicitar(request)
N -> W ++ : SolicitudWizard(request.session)
return wizard
N -> N : $comentario("valida estado de la sesión y flujo")\npaso_actual = paso_solicitado.validar_acceso(wizard.datos)

N -> N ++ : _manejar_paso_confirmacion(request, wizard)
N -> W ++ : wizard.obtener_resumen()
return resumen
N -> N : $comentario("revisa si se aceptaron los términos y condiciones (AC10)")\nacepta_terminos = bool(request.POST.get("acepta_terminos"))

alt no aceptó los términos
  N --> S : 200 · solicitudes/solicitar.html con mensaje de error
  note right of N
    La solicitud no puede enviarse ni
    registrarse sin aceptar los términos y
    condiciones del servicio (AC10).
  end note
else aceptó los términos
  N -> V ++ : guardar_solicitud_completa(request.user, wizard.datos)
  group @transaction.atomic
    V -> D ++ : SELECT personas_area
    return fila
    V -> V ++ : marcas(usuario, fecha, len(bloques_ids))
    V -> C ++ : Parametros.cargar()
    C -> D ++ : SELECT configuracion_parametros
    return fila
    return parametros
    V -> D ++ : $comentario("los bloques vivos de la persona en ese mes")\nSELECT solicitudes_solicitudbloque, solicitudes_solicitud
    return filas
    return marcas
    note right of V
      US-04: pasar un tope no impide enviar.
      La marca queda guardada para el validador
      y no cambia si después cambia el tope (AC3).
    end note
    V -> V : $comentario("la solicitud pendiente (AC5), con sus marcas")\nsolicitud = Solicitud(solicitante, area, motivo, personas, ...,\n**{campo: True for campo in marcas})
    V -> V ++ : solicitud.full_clean()
    deactivate V
    V -> V ++ : solicitud.save()
    V -> D ++ : INSERT solicitudes_solicitud
    deactivate D
    deactivate V
    V -> D ++ : SELECT agenda_bloque
    return filas
    alt algún bloque no es válido o está inactivo
      V --> N : ValidationError
      N --> S : 200 · solicitudes/solicitar.html con mensaje de error
    else bloques vigentes
      loop cada bloque horario seleccionado
        V -> V : sol_bloque = SolicitudBloque(solicitud, bloque, fecha)
        V -> V ++ : sol_bloque.full_clean()
        V -> A ++ : $comentario("US-17 AC3: lo bloqueado no se puede pedir")\nbloqueo_de(fecha, bloque.inicio)
        A -> D ++ : SELECT agenda_bloqueo, agenda_bloque
        return filas
        return bloqueo
        V -> D ++ : $comentario("¿ya reservado o ya pedido por la misma persona?")\nSELECT solicitudes_solicitudbloque, solicitudes_solicitud
        return filas
        deactivate V
        note right of V
          Fecha fuera de plazo, bloque bloqueado,
          reservado o ya pedido: ValidationError,
          no se guarda nada y el paso 3 lo avisa.
        end note
        V -> V ++ : sol_bloque.save()
        V -> D ++ : INSERT solicitudes_solicitudbloque
        deactivate D
        deactivate V
      end
      loop cada acompañante con nombre y correo (AC6)
        V -> D ++ : INSERT solicitudes_acompanante
        deactivate D
      end
    end
  end
  note right of V
    La transacción atómica garantiza que la solicitud,
    sus bloques instanciados y los acompañantes se guarden
    juntos. Si algo falla, nada persiste en la base.
  end note
  return solicitud
  N -> W ++ : wizard.limpiar()
  W -> W : $comentario("elimina los datos temporales del asistente")\ndel request.session[SESSION_KEY]
  return
  N --> S : 200 · solicitudes/enviada.html con resumen de la reserva
end
deactivate N
deactivate N
@enduml
