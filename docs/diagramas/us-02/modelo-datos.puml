@startuml modelo-datos
skinparam dpi 200
skinparam shadowing false
skinparam roundcorner 4
skinparam class {
    BackgroundColor #FFFFFF
    ArrowColor #123F6D
    BorderColor #52606D
}

title Modelo de Datos: Solicitud de Reserva y Bloques Horarios (US-02)

entity "<b>personas_usuario</b>" as Usuario {
    * <b>id</b> : bigint <<PK>>
    --
    * email : varchar(254)
    * first_name : varchar(150)
    * last_name : varchar(150)
    * is_active : boolean
}

entity "<b>personas_area</b>" as Area {
    * <b>id</b> : bigint <<PK>>
    --
    * nombre : varchar(120) <<unique>>
    * prioridad : smallint
    * activa : boolean
}

entity "<b>personas_usuario_areas</b>" as UsuarioArea {
    * <b>id</b> : bigint <<PK>>
    --
    * <b>usuario_id</b> : bigint <<FK -> personas_usuario.id>>
    * <b>area_id</b> : bigint <<FK -> personas_area.id>>
}

entity "<b>solicitudes_solicitud</b>" as Solicitud {
    * <b>id</b> : bigint <<PK>>
    --
    * <b>solicitante_id</b> : bigint <<FK -> personas_usuario.id>>
    * <b>area_id</b> : bigint <<FK -> personas_area.id>>
    * fecha : date
    * motivo : varchar(300)
    observaciones : text
    * personas : smallint
    * estado_validacion : varchar(20)  /* PENDIENTE | ACEPTADA | RECHAZADA | RETIRADA */
    * estado_confirmacion : varchar(20)  /* NO_HABILITADA | PENDIENTE | CONFIRMADA | CANCELADA */
    * creado_en : timestamptz
    * actualizado_en : timestamptz
}

entity "<b>agenda_bloque</b>" as Bloque {
    * <b>id</b> : bigint <<PK>>
    --
    * dia : smallint  /* 0=lunes .. 4=viernes */
    * inicio : time
    * termino : time
    * activo : boolean
}

entity "<b>solicitudes_solicitudbloque</b>" as SolicitudBloque {
    * <b>id</b> : bigint <<PK>>
    --
    * <b>solicitud_id</b> : bigint <<FK -> solicitudes_solicitud.id>>
    * <b>bloque_id</b> : bigint <<FK -> agenda_bloque.id>>
    --
    <<unique(solicitud_id, bloque_id)>>
}

entity "<b>solicitudes_acompanante</b>" as Acompanante {
    * <b>id</b> : bigint <<PK>>
    --
    * <b>solicitud_id</b> : bigint <<FK -> solicitudes_solicitud.id>>
    * nombre : varchar(120)
    * correo : varchar(254)
}

' Relaciones y claves foráneas referenciales
Usuario ||--o{ UsuarioArea : "puede pedir para"
Area ||--o{ UsuarioArea
Usuario ||..o{ Solicitud : "solicita (1:N)"
Area ||..o{ Solicitud : "pertenece a (1:N)"
Solicitud ||--|{ SolicitudBloque : "contiene (1:N, on_delete=CASCADE)"
Bloque ||--o{ SolicitudBloque : "se pide en (1:N, on_delete=PROTECT)"
Solicitud ||--o{ Acompanante : "declara acompañantes (1:N, on_delete=CASCADE)"

note bottom of SolicitudBloque
  <b>agenda_bloque</b> representa la plantilla semanal recurrente (día y horas).
  <b>solicitudes_solicitud</b> lleva la <b>fecha</b> de la reserva: una solicitud es de un solo día.
  <b>solicitudes_solicitudbloque</b> dice qué bloques de la plantilla se usan ese día.
end note

@enduml
