@startuml login
!include ../estilo.iuml
title Inicio de sesión (US-01)
hide footbox
autonumber "<b>0."

actor Solicitante as P
participant "Vista del solicitante" as N <<presentación>>
participant Usuarios as V <<dominio>>
participant Configuración as C <<dominio>>
participant "Base de datos" as D <<persistencia>>

P -> N : Ingresa correo y contraseña
N -> V : Envía las credenciales
V -> D : Busca la cuenta

alt Cuenta bloqueada
  V --> N : Indica cuántos minutos faltan
else Credenciales correctas y rol de la puerta
  V -> D : Reinicia los intentos fallidos
  V --> N : Abre la sesión y redirige a su panel
  N --> P : Muestra su panel
else Credenciales incorrectas o sin el rol
  V -> C : Consulta el máximo de intentos
  V -> D : Suma un intento y bloquea si llegó al máximo
  V --> N : "Correo o contraseña incorrectos."
end
@enduml
