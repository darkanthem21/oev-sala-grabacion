@startuml modelo-configuracion
!include ../estilo.iuml
hide circle
hide empty members
<style>
classDiagram {
  FontSize 12
  class { BackGroundColor #E8F2EB; LineColor #2F5E3C; RoundCorner 4 }
  arrow { FontName "JetBrainsMono NF"; FontSize 11; LineColor #123F6D }
  note { FontSize 11; BackGroundColor #FDF8E7; LineColor #CDBB7A }
  .ajena { BackGroundColor #FFFFFF; LineColor #9AA5B1; FontColor #616E7C }
}
</style>
title Modelo de datos de configuración (US-04)

entity "<b>configuracion_parametros</b>" as Parametros {
  <b>id</b> : bigint «PK»  /* siempre 1 */
  --
  pedir_dia : smallint  /* 0=lunes .. 4=viernes */
  pedir_hora : time
  semanas_desfase : smallint  /* 0 .. 8 */
  plazo_confirmacion_dias : smallint  /* 1 .. 30 */
  tope_mensual : smallint  /* 1 .. 40 */
  max_bloques_solicitud : smallint  /* 1 .. 10 */
  inasistencias_para_sancion : smallint  /* 1 .. 10 */
  dias_sancion : smallint  /* 1 .. 365 */
  intentos_maximos : smallint  /* 3 .. 20 */
  minutos_bloqueo : smallint  /* 1 .. 1440 */
  terminos : text
}

entity "<b>configuracion_cambioparametro</b>" as Cambio {
  <b>id</b> : bigint «PK»
  --
  campo : varchar(50)
  antes : text
  despues : text
  <b>quien_id</b> : bigint NULL «FK → personas_usuario.id»
  cuando : timestamptz
}

entity "<b>personas_usuario</b>" as Usuario <<ajena>> {
  <b>id</b> : bigint «PK»
  --
  (ver Modelo de datos de personas)
}

Usuario |o..o{ Cambio : "quien (on_delete=SET_NULL)"
Parametros .[hidden]right. Cambio

note bottom of Parametros
  Una sola fila: save() fija pk = 1 y cargar() la crea
  con los valores por defecto del cliente si no existe
  (AC2). Los rangos son validadores del modelo, que
  revisa el formulario antes de guardar: en la base
  solo está el CHECK de no negativo de cada smallint.
end note

note bottom of Cambio
  La bitácora del AC4: una fila por campo que cambió.
  campo es el nombre de la columna de
  configuracion_parametros, no una FK: un parámetro
  que se quite del modelo sigue en el registro.
  SET_NULL para que la bitácora no impida dar de baja
  a un administrador ni desaparezca con él.
end note
@enduml
