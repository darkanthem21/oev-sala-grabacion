@startuml modelo-agenda
!include ../estilo.iuml
hide circle
hide empty members
<style>
classDiagram {
  FontSize 12
  class { BackGroundColor #E8F2EB; LineColor #2F5E3C; RoundCorner 4 }
  arrow { FontName "JetBrainsMono NF"; FontSize 11; LineColor #123F6D }
  note { FontSize 11; BackGroundColor #FDF8E7; LineColor #CDBB7A }
  .ajena { BackGroundColor #FFFFFF; LineColor #9AA5B1; FontColor #616E7C }
}
</style>
title Modelo de datos de agenda (US-04 y US-17)

entity "<b>agenda_bloque</b>" as Bloque {
  <b>id</b> : bigint «PK»
  --
  dia : smallint  /* 0=lunes .. 4=viernes */
  inicio : time
  termino : time
  activo : boolean
  --
  «check» termino > inicio
  «unique» (dia, inicio) donde activo
}

entity "<b>agenda_bloqueo</b>" as Bloqueo {
  <b>id</b> : bigint «PK»
  --
  desde : date
  hasta : date
  <b>bloque_id</b> : bigint NULL «FK → agenda_bloque.id»
  motivo : varchar(10)  /* mantencion | feriado | evento */
  detalle : varchar(120)
  <b>bloqueado_por_id</b> : bigint NULL «FK → personas_usuario.id»
  bloqueado_en : timestamptz
  <b>levantado_por_id</b> : bigint NULL «FK → personas_usuario.id»
  levantado_en : timestamptz NULL
  motivo_levantamiento : varchar(200)
  --
  «check» hasta >= desde
  «check» bloque_id IS NULL o hasta = desde
}

entity "<b>personas_usuario</b>" as Usuario <<ajena>> {
  <b>id</b> : bigint «PK»
  --
  (ver Modelo de datos de personas)
}

Bloque |o--o{ Bloqueo : "bloque (on_delete=PROTECT)"
Usuario |o..o{ Bloqueo : "bloqueado_por (on_delete=SET_NULL)"
Usuario |o..o{ Bloqueo : "levantado_por (on_delete=SET_NULL)"

note right of Bloque
  La plantilla semanal: un bloque es un tramo
  de un día de la semana, sin fecha. Nunca se
  borra (US-04 AC3): quitarlo pone activo en
  falso, y por eso el único es parcial.
  solicitudes_solicitudbloque lo apunta (ver
  el modelo de datos de US-02).
end note

note bottom of Bloqueo
  Fechas concretas sin sala. Sin bloque alcanza el
  día completo, o varios si hasta > desde; con bloque,
  solo ese bloque en una fecha. Nunca se borra:
  levantarlo llena levantado_por, levantado_en y
  motivo_levantamiento, así que la tabla es también
  el registro (US-17 AC5 y AC6). Los vigentes son los
  que tienen levantado_en vacío.
end note
@enduml
