personas_usuario ||--o{ personas_usuario_areas : usuario_id
auth_group ||--o{ personas_usuario_groups : group_id
personas_usuario ||--o{ personas_usuario_groups : usuario_id
auth_permission ||--o{ personas_usuario_user_permissions : permission_id
personas_usuario ||--o{ personas_usuario_user_permissions : usuario_id
