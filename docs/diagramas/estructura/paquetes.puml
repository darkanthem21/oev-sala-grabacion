@startuml paquetes
!include ../estilo.iuml
skinparam componentStyle rectangle
<style>
componentDiagram {
  FontSize 12
  component { RoundCorner 4; LineThickness 1; Padding 8 }
  arrow { FontName "JetBrainsMono NF"; FontSize 11; LineColor #123F6D }
  note { FontSize 11; BackGroundColor #FDF8E7; LineColor #CDBB7A }
  .presentación { BackGroundColor #E6EEF7; LineColor #123F6D }
  .dominio { BackGroundColor #EFEBF5; LineColor #4C3F78 }
  package { LineColor #9AA5B1; FontColor #616E7C }
}
</style>
title Apps de Django y sus dependencias

component "<b>oev</b>\n<size:11>urls.py, settings.py</size>" as oev <<presentación>>
package "apps del proyecto" as apps {
  component "<b>uso</b>\n<size:11>bloques del día y check-out (US-14)</size>\n<size:11>sin modelos propios</size>" as uso <<dominio>>
  component "<b>solicitudes</b>\n<size:11>Solicitud, SolicitudBloque, Acompanante</size>\n<size:11>reserva, validación, historial (US-02, 03, 07, 09)</size>" as solicitudes <<dominio>>
  component "<b>agenda</b>\n<size:11>Bloque, Bloqueo</size>\n<size:11>jornada y bloqueos (US-04, US-17)</size>" as agenda <<dominio>>
  component "<b>personas</b>\n<size:11>Usuario, Area, Rol</size>\n<size:11>puertas de ingreso (US-01, US-08)</size>" as personas <<dominio>>
  component "<b>configuracion</b>\n<size:11>Parametros, CambioParametro (US-04)</size>" as configuracion <<dominio>>
  component "<b>notificaciones</b>\n<size:11>avisar(): correos</size>\n<size:11>sin modelos propios</size>" as notificaciones <<dominio>>
}

oev --> apps : urls.py importa las vistas de uso, solicitudes,\nagenda, personas y configuracion, y personas.models.Rol

uso --> solicitudes : Solicitud, SolicitudBloque
uso --> agenda : bloqueos_por_fecha
uso --> personas : Rol

solicitudes --> agenda : Bloque, Bloqueo, Dia, disponibilidad,\nbloqueo_de, bloqueos_por_fecha,\nprimera_fecha_pedible,\nsignals: Reserva, reservas_aprobadas\n· FK bloque
solicitudes --> personas : Area, Rol\n· FK solicitante, resuelta_por
solicitudes --> configuracion : Parametros
solicitudes --> notificaciones : avisar

agenda --> configuracion : Parametros
agenda --> notificaciones : avisar
agenda -[dotted]-> personas : FK bloqueado_por, levantado_por

personas --> configuracion : Parametros

configuracion -[dotted]-> personas : FK quien

agenda -[#4C3F78,dashed]-> solicitudes : <color:#4C3F78>señal reservas_aprobadas.send()</color>

legend right
  <b>───</b>  import
  <b>· · ·</b>  FK escrita como texto (settings.AUTH_USER_MODEL),
         sin import
  <color:#4C3F78><b>- - -</b></color>  señal: llamada en ejecución, sin import
endlegend

note right of agenda
  Para saber a quién le quita la sala un
  bloqueo (US-17 AC4), agenda envía la señal
  reservas_aprobadas y contesta solicitudes,
  que la conectó en apps.py. Así agenda no
  importa a solicitudes, que depende de ella.
end note
@enduml
