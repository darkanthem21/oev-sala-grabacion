@startuml bloques-del-dia
!include ../estilo.iuml
hide footbox
autonumber
title Ver los bloques del día (US-14)

actor "Personal de apoyo" as A
participant "<b>uso.views</b>\n<size:11>uso/views.py</size>" as N <<presentación>>
participant "<b>uso</b>\n<size:11>uso/services.py</size>" as V <<dominio>>
participant "<b>agenda</b>\n<size:11>agenda/models.py</size>" as G <<dominio>>
database "<b>PostgreSQL</b>\n<size:11>base oev</size>" as D <<persistencia>>

A -> N ++ : GET /apoyo/?fecha=AAAA-MM-DD → bloques(request)
N -> N : hoy = timezone.localdate()
N -> N : $comentario("la fecha que viene en la dirección")\nfecha = date.fromisoformat(request.GET.get("fecha", ~"~"))
opt falta la fecha o no se puede leer
  N -> N : fecha = hoy
  note right of N : AC3. Una fecha mal escrita\nno es un error.
end
N -> N ++ : _enviados(request)
return enviados
N -> V ++ : bloques_del_dia(fecha, enviados)
V -> V : ahora = timezone.localtime()
V -> G ++ : bloqueos_por_fecha(fecha, fecha)
G -> D ++ : SELECT agenda_bloqueo, agenda_bloque
return filas
return bloqueos
V -> V ++ : _tickets(fecha=fecha)
V -> D ++ : $comentario("los bloques de solicitudes aceptadas en esa fecha (AC4)")\nSELECT solicitudes_solicitudbloque, solicitudes_solicitud, agenda_bloque, personas_usuario, personas_area
return filas
V -> V : $comentario("aprobada, confirmada o cancelada, según la confirmación")\nestado = ESTADOS[f.solicitud.estado_confirmacion]
return tickets
loop cada ticket
  V -> V ++ : _armar(t, enviados, ahora)
  return bloque
end
note right of V
  Los cancelados se listan marcados (AC5). _armar
  deja el check-out completado, pendiente o sin
  check-out (no ha terminado o se canceló).
end note
loop cada bloque
  V -> V : $comentario("el bloqueo que le quitó la sala, si hay uno (US-17 AC2)")\nbloque["bloqueo"] = next((b for b in bloqueos if b.cubre(fecha, bloque["inicio"])), None)
end
V -> V : $comentario("en el orden en que van a llegar (AC1)")\nsorted(bloques, key=lambda b: b["inicio"])
return bloques
N -> G ++ : $comentario("para avisar del bloqueo aunque ese día no haya reservas")\nbloqueos_por_fecha(fecha, fecha)
G -> D ++ : SELECT agenda_bloqueo, agenda_bloque
return filas
return bloqueos
N --> A : 200 · uso/bloques.html
deactivate N
@enduml
