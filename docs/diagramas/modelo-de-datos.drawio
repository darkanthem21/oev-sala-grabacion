RmandOne;endArrow=ERzeroToOne;startFill=0;endFill=0;startSize=10;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="checkout" target="incidente"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rel8" style="edgeStyle=none;rounded=0;html=1;startArrow=ERzeroToOne;endArrow=ERzeroToOne;startFill=0;endFill=0;startSize=10;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="incidente" target="sancion"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rel9" style="edgeStyle=none;rounded=0;html=1;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;startSize=10;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sancion" target="usuario"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1505" y="1542.0"/><mxPoint x="1505" y="690"/><mxPoint x="1505" y="690"/><mxPoint x="1443.0" y="690"/></Array></mxGeometry></mxCell><mxCell id="rel10" style="edgeStyle=none;rounded=0;html=1;startArrow=none;endArrow=none;startFill=0;endFill=0;startSize=10;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="usuario" target="usuario_rol"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rel10_o" value="N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontStyle=1;" vertex="1" connectable="0" parent="rel10"><mxGeometry x="-0.85" y="-10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="rel11" style="edgeStyle=none;rounded=0;html=1;startArrow=none;endArrow=none;startFill=0;endFill=0;startSize=10;endSize=10;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="usuario_rol" target="rol"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rel11_d" value="N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontStyle=1;" vertex="1" connectable="0" parent="rel11"><mxGeometry x="0.85" y="-10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="rel12" style="edgeStyle=none;rounded=0;html=1;startArrow=none;endArrow=none;startFill=0;endFill=0;startSize=10;endSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="usuario" target="usuario_area"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rel12_o" value="N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontStyle=1;" vertex="1" connectable="0" parent="rel12"><mxGeometry x="-0.85" y="-10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="rel13" style="edgeStyle=none;rounded=0;html=1;startArrow=none;endArrow=none;startFill=0;endFill=0;startSize=10;endSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="usuario_area" target="area"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rel13_d" value="N" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontStyle=1;" vertex="1" connectable="0" parent="rel13"><mxGeometry x="0.85" y="-10" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="titulo" value="&lt;b&gt;Modelo de datos — Sala de grabación OEV&lt;/b&gt;&lt;br&gt;Actualizado al 29/09/2026 con el código de main y la US-17. La versión anterior está en la página «Versión anterior»." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="900" height="50" as="geometry"/></mxCell><mxCell id="notas_t" value="&lt;b&gt;Notas y decisiones&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2060" y="270" width="380" height="20" as="geometry"/></mxCell><mxCell id="nota0" value="Decisión: una solicitud genera &lt;b&gt;un ticket por cada bloque pedido&lt;/b&gt;. Se aprueba o rechaza cada ticket; el estado de la solicitud no se guarda, se deduce de sus tickets: pendiente, en revisión, aprobada, rechazada o &lt;b&gt;aprobada en parte&lt;/b&gt;. (Responde la pregunta «IMPORTANTE» de la versión anterior.)" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=left;verticalAlign=top;rounded=0;dashed=1;dashPattern=12 12;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2060" y="300" width="380" height="112" as="geometry"/></mxCell><mxCell id="nota1" value="&lt;b&gt;Bloque&lt;/b&gt; es la plantilla semanal (p. ej. «martes 09:40–11:10») y no tiene fecha. La fecha va en el ticket. Solo &lt;b&gt;un ticket aprobado por (bloque, fecha)&lt;/b&gt;: restricción única en la base." style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=left;verticalAlign=top;rounded=0;dashed=1;dashPattern=12 12;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2060" y="426" width="380" height="82" as="geometry"/></mxCell><mxCell id="nota2" value="&lt;b&gt;Bloqueo&lt;/b&gt; (US-17): fechas en que la sala no está. Sin bloque = día completo; con bloque = solo ese bloque en esa fecha. Nunca se borra: levantarlo deja quién, cuándo y por qué." style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=left;verticalAlign=top;rounded=0;dashed=1;dashPattern=12 12;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2060" y="522" width="380" height="82" as="geometry"/></mxCell><mxCell id="nota3" value="Personal de apoyo, validador y administrador &lt;b&gt;no son entidades aparte&lt;/b&gt;: son Usuarios con un Rol. Un usuario puede tener varios roles." style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=left;verticalAlign=top;rounded=0;dashed=1;dashPattern=12 12;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2060" y="618" width="380" height="67" as="geometry"/></mxCell><mxCell id="nota4" value="La &lt;b&gt;prioridad&lt;/b&gt; es del Área (el validador ordena los topes por ella); se quitó de la Solicitud." style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=left;verticalAlign=top;rounded=0;dashed=1;dashPattern=12 12;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2060" y="699" width="380" height="52" as="geometry"/></mxCell><mxCell id="nota5" value="&lt;b&gt;Check-out&lt;/b&gt; va por ticket (un bloque en una fecha) y lo registra el personal de apoyo. El &lt;b&gt;incidente&lt;/b&gt; es 0..1 por check-out y lo cierra el administrador." style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=left;verticalAlign=top;rounded=0;dashed=1;dashPattern=12 12;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2060" y="765" width="380" height="67" as="geometry"/></mxCell><mxCell id="nota6" value="&lt;b&gt;Sanción&lt;/b&gt;: automática tras N inasistencias (Parámetros) o por un incidente, por eso id_incidente puede ir vacío. Ya no lleva «vigente»: se calcula con fecha_termino." style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=left;verticalAlign=top;rounded=0;dashed=1;dashPattern=12 12;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2060" y="846" width="380" height="67" as="geometry"/></mxCell><mxCell id="nota7" value="&lt;b&gt;Valores fijos (*)&lt;/b&gt;&lt;br&gt;Bloqueo.motivo: mantención | feriado | evento&lt;br&gt;Ticket.estado: pendiente | aprobado | rechazado&lt;br&gt;Ticket.estado_confirmacion: null | pendiente | confirmada | cancelada&lt;br&gt;Incidente.estado: abierto | cerrado" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=left;verticalAlign=top;rounded=0;dashed=1;dashPattern=12 12;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2060" y="927" width="380" height="112" as="geometry"/></mxCell><mxCell id="nota8" value="&lt;b&gt;Descartado:&lt;/b&gt; Bloque_Área (exclusividad horaria por área, req. de la profe). Se puede conservar como sugerencia para el validador." style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=left;verticalAlign=top;rounded=0;dashed=1;dashPattern=12 12;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2060" y="1053" width="380" height="67" as="geometry"/></mxCell><mxCell id="nota9" value="&lt;b&gt;Por definir con el equipo:&lt;/b&gt; si se necesita el rut; reglas automáticas de reincidencia (p. ej. sanción de un año); la bandeja de salida de notificaciones." style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=none;align=left;verticalAlign=top;rounded=0;dashed=1;dashPattern=12 12;spacing=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2060" y="1134" width="380" height="67" as="geometry"/></mxCell><mxCell id="leyenda_t" value="&lt;b&gt;Leyenda&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1240" width="200" height="20" as="geometry"/></mxCell><mxCell id="ley0" value="id" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f0a30a;strokeColor=#BD7000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="1270" width="110" height="20" as="geometry"/></mxCell><mxCell id="ley0_d" value="Clave primaria" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="160" y="1270" width="300" height="20" as="geometry"/></mxCell><mxCell id="ley1" value="id_x" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#008a00;fontColor=#ffffff;strokeColor=#005700;" vertex="1" parent="1"><mxGeometry x="40" y="1296" width="110" height="20" as="geometry"/></mxCell><mxCell id="ley1_d" value="Clave foránea («→ Usuario»: no se dibuja la línea)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="160" y="1296" width="300" height="20" as="geometry"/></mxCell><mxCell id="ley2" value="atributo" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1322" width="110" height="20" as="geometry"/></mxCell><mxCell id="ley2_d" value="Atributo" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="160" y="1322" width="300" height="20" as="geometry"/></mxCell><mxCell id="ley3" value="estado *" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="1348" width="110" height="20" as="geometry"/></mxCell><mxCell id="ley3_d" value="Valores fijos (ver notas)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="160" y="1348" width="300" height="20" as="geometry"/></mxCell><mxCell id="ley4" value="atributo" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;strokeColor=#0050ef;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="1374" width="110" height="20" as="geometry"/></mxCell><mxCell id="ley4_d" value="Atributo agregado en esta versión" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="160" y="1374" width="300" height="20" as="geometry"/></mxCell><mxCell id="ley_e1" value="&lt;b&gt;Entidad&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1400" width="110" height="30" as="geometry"/></mxCell><mxCell id="ley_e1d" value="Ya existe en el código" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="160" y="1405" width="300" height="20" as="geometry"/></mxCell><mxCell id="ley_e2" value="&lt;b&gt;Entidad&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1440" width="110" height="30" as="geometry"/></mxCell><mxCell id="ley_e2d" value="Por implementar" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="160" y="1445" width="300" height="20" as="geometry"/></mxCell><mxCell id="ley_c" value="Cardinalidad en pata de gallo: | = uno, o = cero, pata = muchos. Los rombos (N-N) son tablas intermedias." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1484" width="400" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram>
