@startuml ir-al-panel
!include ../estilo.iuml
hide footbox
autonumber
title Ir al panel desde la raíz (US-08)

actor "Usuario" as U
participant "<b>personas.views</b>\n<size:11>personas/views.py</size>" as N <<presentación>>
participant "<b>personas</b>\n<size:11>personas/models.py</size>" as V <<dominio>>
database "<b>PostgreSQL</b>\n<size:11>base oev</size>" as D <<persistencia>>

U -> N ++ : GET / → panel(request)
break sin sesión
  N --> U : 302 · /solicitante/entrar/?next=/
  note right of N
    Lo responde @login_required con LOGIN_URL,
    que es la puerta del solicitante.
  end note
end
N -> N ++ : destino_tras_login(request.user)
note right of N
  is_staff cuenta como administrador: el
  superusuario del despliegue no está en
  ningún grupo y no se pregunta por él.
end note
opt no es is_staff
  N -> V ++ : usuario.tiene_rol(Rol.ADMINISTRADOR)
  V -> D ++ : SELECT personas_usuario_groups ⋈ auth_group
  return fila
  return es_administrador
end
opt tampoco es administrador
  N -> V ++ : usuario.tiene_rol(Rol.VALIDADOR)
  V -> D ++ : SELECT personas_usuario_groups ⋈ auth_group
  return fila
  return es_validador
end
opt tampoco es validador
  N -> V ++ : usuario.tiene_rol(Rol.APOYO)
  V -> D ++ : SELECT personas_usuario_groups ⋈ auth_group
  return fila
  return es_apoyo
end
note right of V
  Los roles son grupos y una persona puede
  tener varios (AC6). Se pregunta en orden de
  prioridad y se deja de preguntar en el
  primero que tiene.
end note
return $comentario("el panel del primer rol que tiene; sin ninguno, el formulario de reserva")\nreverse("panel_bloques" | "panel_validador" | "panel_apoyo" | "solicitar")
N -> N : redirect(destino)
N --> U : 302 · /configuracion/bloques/, /validador/, /apoyo/ o /solicitar/
deactivate N
@enduml
