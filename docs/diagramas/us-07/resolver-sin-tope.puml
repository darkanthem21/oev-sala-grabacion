@startuml resolver-sin-tope
!include ../estilo.iuml
hide footbox
autonumber
title Resolver una solicitud sin tope (US-07)

actor "Validador" as A
participant "<b>panelValidador</b>\n<size:11>solicitudes/_validacion.html</size>" as P <<presentación>>
participant "<b>solicitudes.views</b>\n<size:11>solicitudes/views.py</size>" as N <<presentación>>
participant "<b>solicitudes.services</b>\n<size:11>solicitudes/services.py</size>" as V <<dominio>>
participant "<b>notificaciones</b>\n<size:11>notificaciones/services.py</size>" as M <<dominio>>
database "<b>PostgreSQL</b>\n<size:11>base oev</size>" as D <<persistencia>>

A -> P ++ : clic en un bloque que pide una sola solicitud → abrir(d, b)
P -> P : $comentario("la ficha de la solicitud en el panel lateral")\nelegir({tipo: "sol", id: vivas[0].id})
P --> A : la ficha, con «Rechazar» y «Aprobar»
deactivate P
A -> P ++ : clic «Rechazar»
P -> P : $comentario("abre el campo del motivo y deja el cursor en él")\nrechazando = solicitud.id; enfocarMotivo()
P --> A : el campo «Motivo del rechazo» en la ficha
deactivate P
A -> P ++ : clic «Confirmar rechazo» → rechazar(solicitud, "s:" + solicitud.id)
P -> P : motivo = (motivos[claveMotivo] || ~"~").trim()
break el motivo tiene menos de 10 caracteres
  P -> P : falla("Escribe el motivo del rechazo (mínimo 10 caracteres).")
  P --> A : el aviso en la ficha, con el cursor en el motivo
end
P -> P ++ : enviar(s, "rechazar", motivo)
P -> P : $comentario("apaga los botones mientras va el pedido: un doble clic mandaría dos")\nenviando = true
P -> N ++ : fetch POST /validador/resolver/ → resolver_solicitud(request)
N -> V ++ : $comentario("url_base: esquema y dominio del sitio, para el enlace del correo")\nresolver(solicitud_id, False, motivo, request.user, url_base=request.build_absolute_uri("/").rstrip("/"))
V -> D ++ : SELECT solicitudes_solicitud
return fila
V -> D ++ : $comentario("_rivales(solicitud): las pendientes del mismo día con algún bloque en común")\nSELECT solicitudes_solicitud ⋈ solicitudes_solicitudbloque
return filas
V -> D ++ : $comentario("la solicitud y sus rivales, en orden de id, para que nadie las resuelva a la vez")\nSELECT … FROM solicitudes_solicitud FOR UPDATE
return filas
alt ya no está pendiente (otro la resolvió o la retiraron)
  V --> N -- : ValidationError
  N --> P -- : 400 · {"error": "Esta solicitud ya fue resuelta o retirada. Recarga la página …"}
  return error
  P -> P : falla(error)
  P --> A : el aviso en la ficha
else
  activate P
  activate N
  activate V
  V -> D ++ : $comentario("RECHAZADA, con motivo, resuelta_por y resuelta_en (AC5)")\nUPDATE solicitudes_solicitud
  deactivate D
  V -> V : $comentario("el correo sale solo si la resolución quedó guardada (AC4)")\ntransaction.on_commit(partial(avisar, correo, …), robust=True)
  V --> N : [solicitud]
  V -> M ++ : avisar(correo, asunto, "notificaciones/resolucion.txt", contexto)
  deactivate M
  deactivate V
  N --> P -- : 200 · {"ok": true}
  P --> P -- : null
  P -> P : registrar(s, "rechazada", motivo, ~"~")
  P -> P : $comentario("aviso flotante de static/js/flotantes.js")\navisar("Rechazaste la solicitud de …")
  P --> A : la solicitud sale de la agenda y pasa a «Resueltas hoy»
end
note right of P
  Aprobar es el mismo camino con aprobar(s, …):
  sin rivales no pide motivo. Antes de enviar,
  la pantalla avisa si un bloque está bloqueado
  o ya no está en la jornada; el servidor lo
  vuelve a revisar. El correo de la aprobada
  trae el enlace para confirmar (US-03).
end note
deactivate P
@enduml
