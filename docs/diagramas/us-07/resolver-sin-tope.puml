@startuml resolver-sin-tope
!include ../estilo.iuml
hide footbox
autonumber
title Resolver una solicitud sin tope (US-07)

actor "Validador" as A
participant "<b>panelValidador</b>\n<size:11>solicitudes/_validacion.html</size>" as P <<presentación>>
participant "<b>solicitudes.views</b>\n<size:11>solicitudes/views.py</size>" as N <<presentación>>
participant "<b>solicitudes.services</b>\n<size:11>solicitudes/services.py</size>" as V <<dominio>>
participant "<b>notificaciones</b>\n<size:11>notificaciones/services.py</size>" as M <<dominio>>
database "<b>PostgreSQL</b>\n<size:11>base oev</size>" as D <<persistencia>>

A -> P ++ : clic «Rechazar solicitud» → abrirRechazo(bloquesDe(s)[0])
P --> A : el campo del motivo en la tarjeta
deactivate P
A -> P ++ : clic «Confirmar» → rechazar(p)
P -> P : motivo = (motivos[p.ticket] || "").trim()
break el motivo tiene menos de 10 caracteres
  P -> P : avisar("Para rechazar escribe el motivo …")
  P --> A : aviso arriba de la bandeja
end
P -> N ++ : $comentario("enviar(p.sol, 'rechazar', motivo)")\nfetch POST /validador/resolver/ → resolver_solicitud(request)
N -> V ++ : resolver(solicitud_id, False, motivo, request.user)
V -> D ++ : $comentario("la solicitud, bloqueada para que nadie la resuelva a la vez")\nSELECT … FROM solicitudes_solicitud FOR UPDATE
return fila
alt ya no está pendiente (otro la resolvió o la retiraron)
  V --> N -- : ValidationError
  N --> P -- : 400 · {"error": "Esta solicitud ya fue resuelta o retirada."}
  P --> A : el aviso
else
  V -> D ++ : $comentario("RECHAZADA, con motivo, resuelta_por y resuelta_en (AC5)")\nUPDATE solicitudes_solicitud
  return fila
  V -> V : transaction.on_commit(partial(avisar, correo, …), robust=True)
  V --> N : [solicitud]
  V -> M ++ : avisar(correo, asunto, "notificaciones/resolucion.txt", contexto)
  deactivate M
  N --> P : 200 · {"ok": true}
  P -> P : registrarSol(p.sol, "rechazado", motivo, "")
  P --> A : la solicitud pasa a «Resueltas»
end
note right of P
  Aprobar sin tope es el mismo camino con
  aprobar(p): sin rivales, el motivo no se
  exige y queda solo la aprobada.
end note
deactivate P
@enduml
