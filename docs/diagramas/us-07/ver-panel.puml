@startuml ver-panel
!include ../estilo.iuml
hide footbox
autonumber
title Abrir el panel del validador (US-07)

actor "Validador" as A
participant "<b>solicitudes.views</b>\n<size:11>solicitudes/views.py</size>" as N <<presentación>>
participant "<b>panelValidador</b>\n<size:11>solicitudes/_validacion.html</size>" as P <<presentación>>
participant "<b>solicitudes.validacion</b>\n<size:11>solicitudes/validacion.py</size>" as V <<dominio>>
participant "<b>agenda</b>\n<size:11>agenda/models.py</size>" as G <<dominio>>
database "<b>PostgreSQL</b>\n<size:11>base oev</size>" as D <<persistencia>>

A -> N ++ : GET /validador/ → panel_validador(request)
N -> N ++ : _datos_validacion()
N -> V ++ : validacion.cargar()
V -> V : $comentario("la semana actual, o la que viene si hoy es sábado o domingo")\nprimera = _lunes(hoy) + timedelta(weeks=1 if hoy.weekday() >= 5 else 0)
V -> D ++ : $comentario("las pendientes desde hoy que tienen bloques, con área y solicitante")\nSELECT solicitudes_solicitud ⋈ personas_area ⋈ personas_usuario
return filas
V -> D ++ : $comentario("prefetch: sus bloques con la hora y sus acompañantes")\nSELECT solicitudes_solicitudbloque ⋈ agenda_bloque, solicitudes_acompanante
return filas
V -> V : $comentario("de la semana actual a la última con pendientes")\nsemanas = [primera + timedelta(weeks=n) for n in …]
V -> D ++ : $comentario("las aceptadas y no canceladas de esas semanas, con sus bloques")\nSELECT solicitudes_solicitud, solicitudes_solicitudbloque
return filas
V -> D ++ : $comentario("lo resuelto hoy, con quién lo resolvió y a quién se asignó (AC5)")\nSELECT solicitudes_solicitud ⋈ personas_usuario, solicitudes_solicitudbloque
return filas
V -> D ++ : $comentario("la jornada con los bloques quitados, y las áreas con su prioridad")\nSELECT agenda_bloque, personas_area
return filas
V -> V ++ : _bloqueos(bloques, primera, hasta)
V -> G ++ : bloqueos_por_fecha(desde, hasta)
G -> D ++ : SELECT agenda_bloqueo ⋈ agenda_bloque
return filas
return bloqueos
V -> V : $comentario("US-17: cada bloque que un bloqueo deja fuera en su fecha, con la razón")\nmarcados.append({"fecha": …, "bloque": bloque.pk, "razon": bloqueo.razon})
return marcados
return datos
return {"datos": datos}
N --> A : 200 · solicitudes/validador.html con datos
deactivate N
note right of N
  La pestaña Validación del administrador es lo
  mismo: GET /configuracion/validacion/ llama a
  panel_validacion_admin, que incluye el mismo
  _validacion.html dentro de panel.html.
end note

A -> P ++ : $comentario("Alpine arranca con los datos incrustados en la página")\npanelValidador(JSON.parse(datos-panel), validador, urlResolver)
P -> P : $comentario("la primera semana con algo que resolver")\nsemana = Math.max(conPendientes, 0)
loop cada día de lunes a viernes
  P -> P ++ : bloquesDel(d)
  P -> P : $comentario("los de la jornada, y los quitados que esa fecha todavía tienen algo")\nb.activo || pedidos(d.iso, b.id).length || reservas(d.iso, b.id).length
  return bloques
  loop cada bloque del día
    P -> P ++ : pedidos(d.iso, b.id)
    P -> P : $comentario("P1 primero (AC2), y después por orden de envío")\nsort((a, b) => area(a).prioridad - area(b).prioridad || a.enviada.localeCompare(b.enviada))
    return pedidos
    P -> P : $comentario("tope si lo piden dos o más; si nadie lo pide, quién lo tiene reservado")\nclases(d, b), nombres(d.iso, b.id)
  end
end
P -> P ++ : get topes(), get sueltas()
return los topes y las solicitudes que nadie más pide
P --> A : la agenda de la semana con quién pide cada bloque, «Por resolver» y «Resueltas hoy»
deactivate P
@enduml
